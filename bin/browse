#!/usr/bin/env python3
"""claude-browse CLI: session ledger wrapper around agent-browser and browser-harness."""
import argparse
import importlib
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

CMDS = {"open": ("cmd_run", "cmd_open"), "run": ("cmd_run", "cmd_run"), "log": ("cmd_run", "cmd_log"),
        "adopt": ("cmd_run", "cmd_adopt"), "ls": ("cmd_admin", "cmd_ls"),
        "reap": ("cmd_admin", "cmd_reap"), "doctor": ("cmd_admin", "cmd_doctor")}


def build():
    """Build the argparse parser."""
    p = argparse.ArgumentParser(prog="browse", description="Session ledger for browser automation.")
    sub = p.add_subparsers(dest="cmd", required=True)
    o = sub.add_parser("open", help="create a session")
    o.add_argument("name")
    o.add_argument("--purpose", required=True)
    o.add_argument("--stack", choices=["ab", "bh"], default="ab")
    o.add_argument("--url")
    o.add_argument("--profile")
    o.add_argument("--allow-domains", dest="allow_domains", default="")
    o.add_argument("--allow-tools", dest="allow_tools", default="")
    o.add_argument("--headed", action="store_true")
    r = sub.add_parser("run", help="run an engine command in a session")
    r.add_argument("name")
    r.add_argument("args", nargs=argparse.REMAINDER)
    ls = sub.add_parser("ls", help="list sessions")
    ls.add_argument("--json", action="store_true")
    ls.add_argument("--all", action="store_true")
    lg = sub.add_parser("log", help="show a session action log")
    lg.add_argument("name")
    lg.add_argument("-n", type=int, default=20)
    lg.add_argument("--json", action="store_true")
    rp = sub.add_parser("reap", help="close idle or orphaned sessions")
    rp.add_argument("--idle-hours", dest="idle_hours", type=float, default=4)
    rp.add_argument("--dry-run", dest="dry_run", action="store_true")
    rp.add_argument("--restart-mismatch", dest="restart_mismatch", action="store_true")
    rp.add_argument("--force", action="store_true")
    rp.add_argument("--quiet", action="store_true")
    sub.add_parser("doctor", help="check binaries, versions and ledger")
    sub.add_parser("adopt", help="register existing daemons")
    return p


def main():
    """Parse args and dispatch to the command module."""
    ns = build().parse_args()
    mod, fn = CMDS[ns.cmd]
    import ledger
    if hasattr(ns, "name") and not ledger.valid_name(ns.name):
        print("usage: invalid session name", file=sys.stderr)
        return 2
    try:
        func = getattr(importlib.import_module(mod), fn)
    except (ImportError, AttributeError) as e:
        print("browse: command %r unavailable (%s)" % (ns.cmd, e), file=sys.stderr)
        return 1
    return func(ns)


if __name__ == "__main__":
    sys.exit(main())

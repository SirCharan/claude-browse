#!/usr/bin/env python3
"""Fake agent-browser shim for tests."""
import json
import os
import sys

argv = sys.argv[1:]
if os.environ.get("FAKE_AB_LOG"):
    with open(os.environ["FAKE_AB_LOG"], "a") as f:
        f.write(" ".join(argv) + "\n")
if os.environ.get("FAKE_AB_SLEEP"):
    import time
    time.sleep(float(os.environ["FAKE_AB_SLEEP"]))
if os.environ.get("FAKE_AB_FAIL") == "1":
    sys.stderr.write("boom\n")
    sys.exit(1)
if "--version" in argv:
    print("0.38.1")
    sys.exit(0)
rest = [a for a in argv if a not in ("--json", "--headed")]
if "--session" in rest:
    i = rest.index("--session")
    del rest[i:i + 2]
if "--profile" in rest:
    i = rest.index("--profile")
    del rest[i:i + 2]
cmd = rest[0] if rest else ""
if cmd == "open":
    data = {"url": rest[1]}
elif cmd == "snapshot":
    data = {"snapshot": '- button "Go" [ref=e1]'}
elif cmd == "session":
    data = {"sessions": []}
elif cmd == "close":
    data = {}
else:
    data = "ok"
print(json.dumps({"success": True, "data": data}))
